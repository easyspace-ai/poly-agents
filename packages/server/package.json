{
  "name": "@poly-agents/server",
  "version": "0.9.2",
  "description": "Standalone headless Poly Agent server (Bun runtime)",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "poly-server": "src/index.ts"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": {
    "name": "Poly Agents Inc.",
    "email": "support@polyagents.ai"
  },
  "license": "Apache-2.0",
  "homepage": "https://agents.polyagents.ai",
  "scripts": {
    "start": "bun run src/index.ts",
    "generate-token": "bun run src/index.ts --generate-token",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@poly-agents/core": "workspace:*",
    "@poly-agents/messaging-gateway": "workspace:*",
    "@poly-agents/server-core": "workspace:*",
    "@poly-agents/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "ws": "^8.16.0"
  }
}
